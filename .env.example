# BA x Designer platform: the ONLY configuration file.
# Copy to .env (gitignored). Every compose file and service reads this file;
# compose only overrides in-network hostnames.

# ── Platform ─────────────────────────────────────────────
PLATFORM_ENV=dev
PLATFORM_PUBLIC_URL=http://localhost:8080
PLATFORM_GATEWAY_PORT=8080
PLATFORM_LOG_LEVEL=INFO
PLATFORM_CORS_ORIGINS=http://localhost:8080
PLATFORM_SWAGGER_ENABLED=true


# -- Logging ---------------------------------------------------
# Local JSON logs: platform/logs/<service>/<service>.log (mounted at LOG_DIR)
LOG_DIR=/logs
# Per-project logs to storage: projects/<project_id>/logs/<service>/<date>/*.jsonl
LOG_PROJECT_TO_STORAGE=true
LOG_PROJECT_FLUSH_SECONDS=30

# ── PostgreSQL (one database, one schema per service) ─────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=15

# ── Auth (mock now; Keycloak later) ───────────────────────
AUTH_MODE=mock
# minimal = only the PM accounts pm.hoa / lead.dung; full = every role + sample projects (tests, e2e_access)
MOCK_SEED=minimal
AUTH_JWT_SECRET=change-me-to-at-least-32-random-characters
AUTH_JWT_TTL_MINUTES=480
AUTH_COOKIE_NAME=platform_token
# Keycloak (OIDC): fill all three to show "Đăng nhập với Keycloak" on the login page.
# The callback /api/core/auth/keycloak/callback is implemented when AUTH_MODE=keycloak lands.
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# ── File storage (keys follow the S3 layout) ──────────────
STORAGE_BACKEND=local                          # local | s3
STORAGE_LOCAL_ROOT=/data/storage
# S3 (STORAGE_BACKEND=s3): source of truth; STORAGE_LOCAL_ROOT becomes its cache
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_ADDRESSING_STYLE=path
S3_VERIFY_SSL=true

# ── LLM gateway (shared) ──────────────────────────────────
LLM_BASE_URL=https://llm-gate.imespro.ai/v1
LLM_API_KEY=

# ── BA module ─────────────────────────────────────────────
BA_LLM_MODEL=Qwen3.5-27B-AWQ
BA_USE_LITELLM_PROXY=false
LITELLM_API_BASE_URL=http://litellm:4000/v1
LITELLM_MODEL_NAME=ba-company
LITELLM_MASTER_KEY=
BA_SLICE_HISTORY=8

# ── Wiki (packages/wiki) ──────────────────────────────────
WIKI_SORT=auto
WIKI_LLM_MODEL=Qwen3.5-27B-AWQ
WIKI_LLM_TIMEOUT_S=60
WIKI_LLM_MAX_CHARS=24000

# ── Designer module ───────────────────────────────────────
# Designer models run on the LiteLLM gateway; leave the two overrides empty
# to reuse LLM_BASE_URL / LLM_API_KEY.
DESIGNER_LLM_BASE_URL=https://litellm.imespro.ai/v1
DESIGNER_LLM_API_KEY=
DESIGNER_LLM_MODEL=openai/gemini-2.5-flash
DESIGNER_CANVAS_MODEL=openai/gemini-2.5-flash
DESIGNER_ENABLED=true
DESIGNER_SHARED_SECRET=change-me
DESIGNER_TIMEOUT_SECONDS=30
# Absolute host folder with read-only design-system .fig libraries
DESIGNER_HOST_DESIGN_SYSTEMS=../design-systems
UNSPLASH_ACCESS_KEY=

# ── OpenPencil (default instance; per-designer instances come later) ──
# Runs outside this stack: cd ../BA/open-pencil && docker compose up -d
OPENPENCIL_MCP_AUTH_TOKEN=
OPENPENCIL_DEFAULT_MCP_URL=http://host.docker.internal:7600/mcp
OPENPENCIL_DEFAULT_EDITOR_URL=http://localhost:1420
MCP_TIMEOUT_SECONDS=150
